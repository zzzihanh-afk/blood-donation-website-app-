{
  "name": "lalbindu-ecosystem",
  "version": "1.0.0",
  "private": true,
  "description": "LalBindu — Bangladesh's Nationwide Blood Donation & Donor Management Ecosystem",
  "scripts": {
    "dev:web": "pnpm --filter @lalbindu/web dev",
    "dev:mobile": "pnpm --filter @lalbindu/mobile start",
    "build:web": "pnpm --filter @lalbindu/web build",
    "build:packages": "pnpm --filter \"@lalbindu/*\" --filter \"!@lalbindu/web\" --filter \"!@lalbindu/mobile\" build",
    "lint": "pnpm -r lint",
    "test": "node --test supabase/tests/schema-rls-test.js"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
